#cloud-config
# Prepares a Quenda host: settings, the operations CLI and Docker. Releases
# arrive afterwards with `pnpm deploy:host`; no secret travels in this file.
write_files:
  - path: /etc/quenda/host.env
    permissions: "0600"
    encoding: b64
    content: ${settings}
  # Compressed: AWS caps user data at 16 KiB and OCI at 32 KiB.
  - path: /usr/local/sbin/quenda
    permissions: "0755"
    encoding: gz+b64
    content: ${cli}
runcmd:
  - [/usr/local/sbin/quenda, install]
