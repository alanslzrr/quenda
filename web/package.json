{
  "name": "quenda-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "test": "node --test test/*.test.ts",
    "test:browser": "node test/browser/run.ts",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "biome check .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "docs:capture": "playwright test --config playwright.docs.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.12",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "1.3.0",
    "@tanstack/react-query": "5.104.5",
    "lucide-react": "0.577.0",
    "motion": "12.23.24",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsqr": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
