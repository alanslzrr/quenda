# Copy to .env.production, restrict it (chmod 600) and replace every placeholder.
# Generate each secret independently, for example: openssl rand -hex 32
# Database role passwords: at least 24 printable ASCII characters; hex avoids URL escaping.
QUENDA_BACKEND_IMAGE=quenda-backend:local
QUENDA_WEB_IMAGE=quenda-web:local

# Public HTTPS origin served by the TLS-terminating entry point in front of the web container.
AUTH_ORIGIN=https://reservas.example.org
AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

BOOTSTRAP_DATABASE_PASSWORD=REPLACE_BOOTSTRAP_PASSWORD
MIGRATION_DATABASE_PASSWORD=REPLACE_MIGRATION_PASSWORD
DOMAIN_DATABASE_PASSWORD=REPLACE_DOMAIN_PASSWORD
AUTH_DATABASE_PASSWORD=REPLACE_AUTH_PASSWORD
WORKER_DATABASE_PASSWORD=REPLACE_WORKER_PASSWORD

MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=REPLACE_SMTP_USER
SMTP_PASSWORD=REPLACE_SMTP_PASSWORD
SMTP_FROM=reservas@example.org
SMTP_TLS=starttls
# Optional certificate name when SMTP_HOST is an IP; empty defaults to SMTP_HOST.
SMTP_SERVERNAME=
# For a private CA, use compose.smtp-ca.example.yaml and set this host path.
# SMTP_CA_HOST_FILE=/absolute/path/to/smtp-ca.pem
EMAIL_LOCALE=gl

# Interface and port where the web container listens; keep loopback when a local proxy terminates TLS.
QUENDA_HTTP_BIND=127.0.0.1
QUENDA_HTTP_PORT=8080
# API trusts only the fixed nginx container address in this composition.
TRUSTED_PROXY_CIDRS=172.28.10.10/32
# Actual peer address/CIDR of the TLS proxy as seen by nginx (one CIDR).
# Replace loopback for your topology; publishing a Docker port may translate the peer.
QUENDA_TRUSTED_PROXY_CIDR=127.0.0.1/32
