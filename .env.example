HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_POOL_MAX=5
IDEMPOTENCY_RETENTION_SECONDS=86400
AUTH_ORIGIN=http://localhost:3000
AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
MAIL_TRANSPORT=local
LOCAL_MAIL_DIR=.local/mail
DOMAIN_DATABASE_URL=postgresql://quenda_domain:REPLACE_DOMAIN_PASSWORD@127.0.0.1:55432/quenda
AUTH_DATABASE_URL=postgresql://quenda_auth:REPLACE_AUTH_PASSWORD@127.0.0.1:55432/quenda

# Optional trusted proxy IPs/CIDRs, comma-separated; empty trusts no proxy.
TRUSTED_PROXY_CIDRS=
